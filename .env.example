# development | staging | production (staging/production enforce Secure cookies,
# bcrypt cost >= 12 and TLS to Postgres unless DB_ALLOW_INSECURE=true).
APP_ENV=development
# Or DATABASE_URL_FILE=/run/secrets/database_url (set only one of the two).
DATABASE_URL=postgres://auth:auth@localhost:5433/auth?sslmode=disable
ADDR=:8080
BCRYPT_COST=12
SESSION_TTL=24h
# Set to false only for plain-http setups where the browser drops Secure cookies.
COOKIE_SECURE=true
SHUTDOWN_TIMEOUT=10s
DB_ALLOW_INSECURE=false
