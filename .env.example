# board-api
PORT=3000
# Postgres connection for board-db (integrations, conversations, messages, provider_events)
DATABASE_URL=postgres://board:board@localhost:5432/board
# Kafka (conversation-events topic)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=conversation-events
KAFKA_GROUP_ID=board-api-events
# Sprintle/Twilio
SPRINTLE_API_BASE_URL=http://localhost:4010
SPRINTLE_WEBHOOK_SECRET=change-me
PROVIDER_TIMEOUT_MS=10000
# 32 random bytes, base64: `openssl rand -base64 32`
CREDENTIALS_ENCRYPTION_KEY=
# Bearer token for /internal/* routes
INTERNAL_API_TOKEN=change-me
# How long cached conversations/messages count as fresh before a fetch-through
CACHE_TTL_SECONDS=30
