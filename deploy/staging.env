# Non-secret staging settings. Secrets (DATABASE_URL) go in deploy/secrets/.
ADDR=:8080
BCRYPT_COST=12
SESSION_TTL=24h
COOKIE_SECURE=true
SHUTDOWN_TIMEOUT=15s
# Staging uses the bundled Postgres on the private compose network.
DB_ALLOW_INSECURE=true
# Login rate limit per client IP (RSK-001).
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=1m
# The TLS reverse proxy on the host reaches the published port via loopback or
# the docker bridge; trust its X-Forwarded-For so limits apply per real client.
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12
