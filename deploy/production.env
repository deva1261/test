# Non-secret production settings. Secrets (DATABASE_URL) go in deploy/secrets/.
# Production expects a managed Postgres reached with sslmode=verify-full.
ADDR=:8080
BCRYPT_COST=12
SESSION_TTL=12h
COOKIE_SECURE=true
SHUTDOWN_TIMEOUT=20s
DB_ALLOW_INSECURE=false
# Login rate limit per client IP (RSK-001).
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=1m
# The TLS reverse proxy on the host reaches the published port via loopback or
# the docker bridge; trust its X-Forwarded-For so limits apply per real client.
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12
